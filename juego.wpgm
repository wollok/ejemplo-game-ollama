import example.*
import wollok.game.*

program Llamita {
	game.title("LLamita")
	game.height(10)
	game.width(10)
	
	game.addVisual(ollama)
	game.addVisualCharacter(wko)

	(0..2).forEach({n => 
		const opcion = opciones.get(n)
		game.addVisual(opcion)
		keyboard.num(n + 1).onPressDo({ opcion.seleccionar() })
	
	})

	game.tick(200, { ollama.flush() }, true).start()
	
	game.start()
}
